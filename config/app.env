# Shared non-secret runtime defaults.
# Local secrets and personal overrides belong in .env.

# Default model. Every model listed in REPORT_AGENT_ALLOWED_MODELS must have a
# profile: built-in OpenAI (gpt-5.4, gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol),
# built-in Anthropic (claude-opus-5, claude-sonnet-5, claude-haiku-4-5), or an
# entry in the custom OpenAI-compatible registry (config/custom_models.json).
# Startup prompts for the API key of each built-in provider backing an
# allowed model (OPENAI_API_KEY, ANTHROPIC_API_KEY). Custom endpoint keys are
# never prompted for: set the entry's api_key_env variable in .env yourself;
# startup only verifies the endpoint and warns on failure.
# REPORT_AGENT_MODEL overrides the default model and outranks the legacy
# OPENAI_MODEL alias below.
#REPORT_AGENT_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5.6-terra
REPORT_AGENT_ALLOWED_MODELS=gpt-5.4,gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
# Title model defaults per provider (OpenAI -> gpt-5.6-luna,
# Anthropic -> claude-haiku-4-5); set explicitly to override.
#REPORT_AGENT_TITLE_MODEL=gpt-5.6-luna
# Custom OpenAI-compatible model registry (e.g. vLLM); see
# config/custom_models.example.json.
#REPORT_AGENT_CUSTOM_MODELS_PATH=config/custom_models.json
REPORT_AGENT_EXECUTION_OUTPUT_SATISFACTION_REVIEW=0
REPORT_AGENT_ATTACHMENT_MAX_BYTES=52428800
REPORT_AGENT_ATTACHMENT_MAX_FILES_PER_MESSAGE=10
REPORT_AGENT_ATTACHMENT_MAX_MESSAGE_BYTES=209715200
REPORT_AGENT_ATTACHMENT_MAX_DOCUMENT_PAGES=200
REPORT_AGENT_ATTACHMENT_MAX_EXTRACTED_CHARS=200000
REPORT_AGENT_ATTACHMENT_MAX_IMAGE_PIXELS=50000000
REPORT_AGENT_ATTACHMENT_STAGED_TTL_SECONDS=86400
REPORT_AGENT_ATTACHMENT_MAX_TABLE_ROWS=100000
REPORT_AGENT_ATTACHMENT_MAX_TABLE_COLUMNS=1000
REPORT_AGENT_ATTACHMENT_MAX_TABLE_CELLS=1000000
# DB-RAG semantic search always embeds with OpenAI, regardless of the chat
# provider; without OPENAI_API_KEY it reports not_configured and the chat
# agent runs without database extraction.
DB_RAG_EMBEDDING_MODEL=OpenAI/text-embedding-3-large
DB_RAG_RERANKER_MODEL=
DB_RAG_DATASET_NAMING_MODEL=gpt-5.6-luna
