# Safe-to-commit template. Copy this file to .env and add your OpenAI API key.
# Shared non-secret defaults live in config/app.env.

OPENAI_API_KEY=

# Authentication mode for deployment. Local mode uses the native launcher.
REPORT_AGENT_AUTH_MODE=local
REPORT_AGENT_AWS_REGION=
REPORT_AGENT_COGNITO_USER_POOL_ID=
REPORT_AGENT_COGNITO_APP_CLIENT_ID=
# Full Cognito Hosted UI endpoint, for example https://your-domain.auth.region.amazoncognito.com/logout
REPORT_AGENT_COGNITO_LOGOUT_ENDPOINT=
REPORT_AGENT_AUTH_REDIRECT_URI=
REPORT_AGENT_AUTH_POST_LOGOUT_REDIRECT_URI=

# Optional location for local conversation state, uploads, and generated data.
REPORT_AGENT_RUNTIME_ROOT=

# Optional location for installed study packages. The installer prompts if unset.
REPORT_AGENT_STUDY_ROOT=

# Required to enable live PubMed literature search; an NCBI API key is optional.
NCBI_EMAIL=
NCBI_API_KEY=
# Optional identifier sent to NCBI E-utilities. Defaults to report-agent.
NCBI_TOOL=report-agent

# Install study packages with study_installer.py; study paths are not configured here.
