# Safe-to-commit template. Copy this file to .env and add one or both provider
# keys. Startup verifies each configured provider and shows all of its models.
# Shared non-secret defaults live in config/app.env.

# Enables all registered GPT models. The built-in embedding profile also reads
# this key independently of the selected chat provider.
OPENAI_API_KEY=

# Optional deployment-owned embedding profile ID from
# config/embedding_models.json. Leave blank to use the registry default. The
# selected profile must match the prebuilt indexes in installed study packages.
DB_RAG_EMBEDDING_PROFILE=

# Enables all registered Claude models.
ANTHROPIC_API_KEY=

# Custom OpenAI-compatible endpoints (e.g. vLLM) are registered in
# config/custom_models.json; each entry may name its own api_key_env there
# (define that variable here). Keyless local endpoints need no entry.

# Optional location for local conversation state, uploads, and generated data.
REPORT_AGENT_RUNTIME_ROOT=

# Optional location for installed study packages. The installer prompts if unset.
REPORT_AGENT_STUDY_ROOT=

# Required to enable live PubMed literature search; an NCBI API key is optional.
NCBI_EMAIL=
NCBI_API_KEY=
# Optional identifier sent to NCBI E-utilities. Defaults to report-agent.
NCBI_TOOL=report-agent

# Install study packages with study_installer.py; study paths are not configured here.
