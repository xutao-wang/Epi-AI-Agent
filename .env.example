# Safe-to-commit template. Copy this file to .env and add one or both provider
# keys. Startup verifies each configured provider and lists supported candidates.
# Shared non-secret defaults live in config/app.env.

# Generated Python uses this account's host permissions. After reading the
# Guarded Local warning, uncomment this acknowledgement for non-interactive
# startup. Interactive startup prompts once and saves the same value to .env.
# REPORT_AGENT_GUARDED_PYTHON_ACKNOWLEDGED=1

# Enables all registered GPT models. The built-in embedding profile also reads
# this key independently of the selected chat provider.
OPENAI_API_KEY=

# Optional deployment-owned embedding profile ID from
# config/embedding_models.json. Leave blank to use the registry default. The
# selected profile must match the prebuilt indexes in installed study packages.
DB_RAG_EMBEDDING_PROFILE=

# Enables all registered Claude models.
ANTHROPIC_API_KEY=

# Enables the OpenRouter models registered in config/custom_models.json with
# "provider": "openrouter". OpenRouter ships no built-in model list; register
# each model slug you want before this key has any effect.
OPENROUTER_API_KEY=

# Upload plug shared secret (at least 32 characters). Needed only when
# REPORT_AGENT_UPLOAD_PLUG_URL is set in config/app.env.
REPORT_AGENT_UPLOAD_PLUG_SECRET=

# Native Bedrock Converse and AWS Mantle chat/tool models. Key region must match.
# Fallbacks: AWS_BEARER_TOKEN_BEDROCK, AWS_REGION, AWS_DEFAULT_REGION.
# Discovery proves catalog access; individual model access is checked on use.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
# Optional Bedrock-only catalog policy; direct and OpenRouter models stay available.
BEDROCK_EXCLUDED_PROVIDERS=
# Optional exact app IDs; omit/leave empty for generic supported-family discovery.
BEDROCK_ALLOWED_MODELS=

# Custom OpenAI-compatible endpoints (e.g. vLLM) are registered in
# config/custom_models.json; each entry may name its own api_key_env there
# (define that variable here). Keyless local endpoints need no entry.

# Optional location for local conversation state, uploads, and generated data.
REPORT_AGENT_RUNTIME_ROOT=

# Optional location for installed study packages. The installer prompts if unset.
REPORT_AGENT_STUDY_ROOT=

# Required to enable live PubMed literature search; an NCBI API key is optional.
NCBI_EMAIL=
NCBI_API_KEY=
# Optional identifier sent to NCBI E-utilities. Defaults to report-agent.
NCBI_TOOL=report-agent

# Install study packages with study_installer.py; study paths are not configured here.
